<?php

/**
 * @file
 * Install/uninstall hooks for Sirius Force SAML.
 */

/**
 * Implements hook_install().
 *
 * If no custom 403 page is configured, point it at user/login so anonymous
 * "access denied" requests get routed to SAML (with ?destination).
 */
function sirius_forcesaml_install() {
  if (!variable_get('site_403', '')) {
    variable_set('site_403', 'user/login');
    variable_set('sirius_forcesaml_set_site_403', TRUE);
  }
}

/**
 * Implements hook_uninstall().
 */
function sirius_forcesaml_uninstall() {
  if (variable_get('sirius_forcesaml_set_site_403', FALSE) && variable_get('site_403', '') == 'user/login') {
    variable_del('site_403');
  }
  variable_del('sirius_forcesaml_set_site_403');
  variable_del('sirius_forcesaml_login_path');
  variable_del('sirius_forcesaml_block_password_reset');
}
